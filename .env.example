NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://dundeuni:dundeuni@localhost:5432/dundeuni?schema=public"
JWT_ACCESS_SECRET=change-me-to-a-long-random-value
JWT_REFRESH_SECRET=change-me-to-a-long-random-value
# 예시 주소이며 실제 CuRe/TruFor 서버임을 확인한 값이 아닙니다.
AI_SERVER_BASE_URL=http://localhost:8000
# mock: 개발 전용 고정 가상 결과, http: 실제 HTTP 어댑터, unavailable: 기존 미연동 동작
AI_PROVIDER=mock
# 추가 시나리오: NO_CLEAR_SIGNAL, BOTH_INCONCLUSIVE, LOCALIZATION
AI_MOCK_SCENARIO=BOTH_SUCCESS
# 기존 기본 예산 유지. AI 개발 설정은 모델당 120초 × 순차 모델 수 + 응답 여유 1초.
# ALL 최악 실행은 241000ms 이상이 필요하며 프록시/세션 TTL과 합의 후 설정.
AI_REQUEST_TIMEOUT_MS=30000
# AI_PROVIDER=http일 때 필수 Bearer 서비스 토큰. 실제 값은 .env/서버 비밀 설정에만 저장.
AI_SERVICE_TOKEN=

# 개발용 제안값. 운영 파일 제한/결과 보관 정책 확정 필요.
ANALYSIS_MAX_FILE_BYTES=10485760
ANALYSIS_RETENTION_SECONDS=86400
