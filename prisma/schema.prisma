generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AnalysisType {
  IMAGE
  TEXT
  URL
}

enum AnalysisStatus {
  QUEUED
  ANALYZING
  COMPLETED
  FAILED
}

model Analysis {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String
  type              AnalysisType
  status            AnalysisStatus @default(QUEUED)
  idempotencyKey    String
  requestHash       String
  aiGenerationScore Float?
  aiRiskLevel       String?
  reasons           Json?
  modelVersion      String?
  errorCode         String?
  createdAt         DateTime       @default(now())
  completedAt       DateTime?
  expiresAt         DateTime

  @@unique([userId, idempotencyKey])
  @@map("analysis_requests")
}
