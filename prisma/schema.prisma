generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AnalysisType {
  IMAGE
  TEXT
  URL
}

enum AnalysisStatus {
  QUEUED
  ANALYZING
  COMPLETED
  FAILED
}

enum ImageResultStatus {
  COMPLETED
  PARTIAL_FAILED
  FAILED
}

enum ImageModelKind {
  GENERATION
  MANIPULATION
}

enum ImageModelStatus {
  SUCCEEDED
  FAILED
}

enum ImageModelDecision {
  AI_GENERATED_SUSPECTED
  NO_CLEAR_GENERATION_SIGNAL
  MANIPULATION_SUSPECTED
  NO_CLEAR_MANIPULATION_SIGNAL
  INCONCLUSIVE
}

enum AnalysisSummaryStatus {
  PENDING
  COMPLETED
  FAILED
}

model Analysis {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String
  type              AnalysisType
  status            AnalysisStatus @default(QUEUED)
  requestHash       String
  aiGenerationScore Float?
  aiRiskLevel       String?
  reasons           Json?
  modelVersion      String?
  errorCode         String?
  createdAt         DateTime       @default(now())
  completedAt       DateTime?
  expiresAt         DateTime

  imageResultStatus ImageResultStatus?
  modelResults      AnalysisModelResult[]
  summary           String?
  summaryStatus     AnalysisSummaryStatus?
  summaryModel      String?
  summarizedAt      DateTime?

  @@map("analysis_requests")
}

model AnalysisModelResult {
  id            String              @id @default(uuid()) @db.Uuid
  analysisId    String              @db.Uuid
  analysis      Analysis            @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  kind          ImageModelKind
  status        ImageModelStatus
  displayScore  Int?
  decision      ImageModelDecision?
  reasons       Json
  limitations   String[]
  modelName     String
  modelVersion  String
  policyVersion String
  errorCode     String?
  retryable     Boolean?

  @@unique([analysisId, kind])
  @@map("analysis_model_results")
}
